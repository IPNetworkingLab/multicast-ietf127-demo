---
interface Props {
    title?: string;
}
const { title } = Astro.props;
const fullTitle = title
    ? `${title} · Flexicast QUIC Demo`
    : "Flexicast QUIC Demo";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
    </head>
    <body>
        <header>
            <a href="/" class="brand">
                Flexicast QUIC Demo
            </a>
            <nav>
                <a href="/">About</a>
                <a href="/receiver">Run a receiver</a>
                <a href="/blog">Updates</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer>IP Networking Lab (INL), UCLouvain</footer>
    </body>
</html>

<style is:global>
    :root {
        color-scheme: light dark;
        --fg: #1d1d1f;
        --muted: #5f6368;
        --bg: #fff;
        --accent: #1a5fb4;
        --code-bg: #f3f4f6;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --fg: #e8e8ea;
            --muted: #a0a4ab;
            --bg: #15161a;
            --accent: #78aeed;
            --code-bg: #24262c;
        }
    }
    body {
        margin: 0 auto;
        max-width: 44rem;
        padding: 0 1.25rem;
        font:
            1.05rem/1.65 system-ui,
            sans-serif;
        color: var(--fg);
        background: var(--bg);
    }
    header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        justify-content: space-between;
        align-items: baseline;
        padding: 1.5rem 0;
        border-bottom: 1px solid color-mix(in srgb, var(--fg) 15%, transparent);
    }
    nav {
        display: flex;
        gap: 1rem;
    }
    .brand {
        font-weight: 700;
        text-decoration: none;
        color: var(--fg);
    }
    a {
        color: var(--accent);
    }
    h1 {
        line-height: 1.2;
    }
    pre {
        padding: 1rem;
        overflow-x: auto;
        border-radius: 6px;
        font-size: 0.9rem;
    }
    :not(pre) > code {
        padding: 0.1em 0.3em;
        border-radius: 4px;
        background: var(--code-bg);
    }
    .muted {
        color: var(--muted);
    }
    .note {
        padding: 0.75rem 1rem;
        border-left: 3px solid var(--accent);
        background: var(--code-bg);
    }
    footer {
        margin: 3rem 0 2rem;
        font-size: 0.9rem;
        color: var(--muted);
    }
</style>
